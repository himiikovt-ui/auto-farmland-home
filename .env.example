# Copy this file to .env.local. Never commit the real values.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# Vision model for the "critique rejected images -> improve prompt" loop.
# Any vision-capable chat model you have access to (e.g. gpt-4.1-mini, gpt-4o,
# gpt-5-mini). Cheap models are fine; this is a small text+image call.
OPENAI_CRITIQUE_MODEL=gpt-4.1-mini

# Optional local storage overrides. SQLite is the live data store; an existing
# data/data.json is imported once and retained as a pre-SQLite backup.
AUTO_FARMLAND_STORAGE_DIR=
AUTO_FARMLAND_DB_FILE=

# --- Etsy Personal Access --------------------------------------------------
# The Etsy app has PERSONAL ACCESS: it may act only on your own shop. All
# testing runs against production shop data. Farmland creates and verifies a
# DRAFT first; activation is a separate reviewed-draft action with typed proof.
ETSY_ACCESS_LEVEL=personal
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Must EXACTLY match the callback registered on the Etsy app. Etsy allows
# http://localhost for development; otherwise use an HTTPS tunnel.
ETSY_REDIRECT_URI=http://localhost:4000/api/auth/etsy/callback
ETSY_SCOPES=shops_r listings_r listings_w
# Optional: pin a specific shop; ownership is validated after OAuth.
ETSY_DEFAULT_SHOP_ID=
# true forces TEST-prefixed titles, TEST DRAFT descriptions, draft state only.
ETSY_DEFAULT_TEST_MODE=true
ETSY_DEFAULT_CREATE_STATE=draft

# The local frontend shown after a successful connection.
APP_ORIGIN=http://localhost:5173

# --- Blog Land publishing (priority 1; local markdown export needs none) ---
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
GHOST_ADMIN_API_URL=
GHOST_ADMIN_API_KEY=

# --- eBay direct API (currently BLOCKED) -----------------------------------
# The eBay Developer Program registration was rejected. The adapter reports
# developer_account_blocked until this flag is flipped to "granted". The
# practical eBay path meanwhile is POD Land (Printful's eBay integration).
EBAY_DEVELOPER_ACCESS=blocked
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Registered RuName / redirect for the eBay OAuth user-consent flow.
EBAY_REDIRECT_URI=
# User token obtained via the OAuth grant (do not commit).
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_US

# --- POD fulfillment providers (planned) ----------------------------------
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTFUL_API_TOKEN=
GELATO_API_KEY=

# --- Later lands (planned adapters) ---------------------------------------
GUMROAD_ACCESS_TOKEN=
